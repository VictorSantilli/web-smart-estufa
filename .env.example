# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# ---------- Aplicação ----------
# development | production
APP_ENV=development
LOG_LEVEL=INFO
# Swagger em /api/docs (pode desligar em produção)
ENABLE_DOCS=true

# ---------- Banco de dados ----------
# Local (docker-compose): usa o SQL Server do serviço "db"
DATABASE_URL=mssql+pyodbc://sa:TroqueEstaSenha!123@db:1433/SmartEstufaDev?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Azure SQL (troque usuário, senha, servidor e banco; senha com caracteres especiais deve ser URL-encoded):
# DATABASE_URL=mssql+pyodbc://app_web:<senha>@<servidor>.database.windows.net:1433/<banco>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Somente para o SQL Server local do docker-compose
MSSQL_SA_PASSWORD=TroqueEstaSenha!123
DEV_DB_NAME=SmartEstufaDev

# ---------- CORS ----------
# Origens permitidas, separadas por vírgula. Em produção o frontend é servido pela
# mesma origem da API, então normalmente fica vazio.
CORS_ORIGINS=http://localhost:5173

# ---------- Autenticação ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# bcrypt até validar o app mobile; depois argon2id
PASSWORD_HASH_SCHEME=bcrypt
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Limite extra de tentativas de login por IP, por minuto
LOGIN_IP_MAX_PER_MINUTE=10
# Cookie de refresh com flag Secure. Vazio = automático (ligado só em produção).
# COOKIE_SECURE=true

# ---------- Regras de negócio ----------
APP_TIMEZONE=America/Sao_Paulo
# sem leitura há mais que isso = offline
STALE_AFTER_MINUTES=15
HISTORY_MAX_DAYS=60
TEMP_MIN=16
TEMP_WARNING=25
TEMP_CRITICAL=26
HUMIDITY_MIN=65
HUMIDITY_MAX=85
